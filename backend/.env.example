# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dealplus
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=dealplus_auth
# Document service (TypeORM + migrations use DB_*)
DB_HOST=localhost
DB_PORT=3306
DB_USER=dealplus
DB_PASSWORD=change_me
DB_NAME=dealplus_documents
# Optional TLS (omit DB_SSL_CA for local MySQL without SSL)
DB_SSL_CA=./ca.pem
RABBITMQ_URL=amqp://dealplus:change_me@localhost:5672
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dealplus
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=dealplus-documents
MINIO_USE_SSL=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,png,jpg,jpeg,gif,txt,csv
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/png,image/jpeg,image/gif,text/plain,text/csv
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
